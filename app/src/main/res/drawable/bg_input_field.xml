<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 포커스 상태 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_color"/>  <!-- 배경 흰색 -->
            <stroke android:width="2dp" android:color="@color/purple"/> <!-- 포인트 보라색 -->
            <corners android:radius="16dp"/>  <!-- 둥근 모서리 -->
        </shape>
    </item>

    <!-- 기본 상태 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_color"/>
            <stroke android:width="1dp" android:color="@color/light_gray"/> <!-- 연회색 -->
            <corners android:radius="16dp"/>
        </shape>
    </item>

</selector>

