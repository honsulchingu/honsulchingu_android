<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color">

    <!-- 이미지 영역 컨테이너 -->
    <FrameLayout
        android:id="@+id/fl_image_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.80"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/iv_example1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="예시1"
            android:scaleType="fitCenter"
            android:src="@drawable/tutorial1"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/ll_example2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_example2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="예시2"
                android:scaleType="fitCenter"
                android:layout_marginRight="20dp"
                android:src="@drawable/tutorial2" />

            <ImageView
                android:id="@+id/iv_example3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="예시3"
                android:scaleType="fitCenter"
                android:src="@drawable/tutorial3" />
        </LinearLayout>
    </FrameLayout>


    <!-- 타이틀 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/pretendard_semibold"
        android:text="화면이 이렇게 보여요"
        android:textAlignment="center"
        android:textColor="@color/info_black"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_image_container" />



</androidx.constraintlayout.widget.ConstraintLayout>
