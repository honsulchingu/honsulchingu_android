<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 캐릭터 이미지 -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageText"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_profile_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:shapeAppearanceOverlay="@style/RoundedCornerImageView" />

    <!-- 전체 말풍선 + 부가정보 묶음 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bubbleWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageText"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 말풍선 내부 내용 (Text + 하트 + 시간) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bubbleContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 메시지 텍스트 -->
            <TextView
                android:id="@+id/messageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chat_bubble_ai"
                android:fontFamily="@font/pretendard_medium"
                android:maxWidth="162dp"
                android:padding="12dp"
                android:text="가나다라"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 하트 버튼 -->
            <ImageButton
                android:id="@+id/heartText"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:background="@android:color/transparent"
                android:contentDescription="하트"
                android:src="@drawable/ic_heart"
                android:visibility="invisible"
                app:layout_constraintBottom_toTopOf="@id/timeText"
                app:layout_constraintStart_toEndOf="@id/messageText" />

            <!-- 타임스탬프 -->
            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="12:00 AM"
                android:textColor="@android:color/darker_gray"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/messageText"
                app:layout_constraintStart_toEndOf="@id/messageText" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
