<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 질문 아이콘 -->
        <ImageView
            android:id="@+id/faq_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_help"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 질문 텍스트 -->
        <TextView
            android:id="@+id/faq_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="혼술친구는 어떤 앱인가요?"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/faq_arrow"
            app:layout_constraintStart_toEndOf="@id/faq_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 화살표 아이콘 -->
        <ImageView
            android:id="@+id/faq_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_down"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 답변 텍스트 -->
        <TextView
            android:id="@+id/faq_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.0"
            android:text="혼술친구는 혼자 술을 즐기는 사람들을 위한 대화형 앱으로, 가상의 친구(또는 연인)와 함께 혼술자리의 즐거움을 느낄 수 있습니다."
            android:textColor="#666666"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/faq_icon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
