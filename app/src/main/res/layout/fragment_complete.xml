<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    android:padding="24dp">

    <ImageView
        android:id="@+id/iv_check"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_check"
        android:scaleType="center"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_complete_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_complete_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI와 함께할 준비 되셨나요?"
        android:textSize="24sp"
        android:textColor="@color/info_black"
        android:fontFamily="@font/pretendard_semibold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_check"
        app:layout_constraintBottom_toTopOf="@id/tv_complete_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_complete_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="이제 AI 캐릭터를 선택하고\nAI와 나만의 특별한 대화를 시작해보세요"
        android:textSize="16sp"
        android:textColor="#8E8E93"
        android:fontFamily="@font/pretendard_medium"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintTop_toBottomOf="@id/tv_complete_title"
        app:layout_constraintBottom_toTopOf="@id/btn_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="시작하기"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semibold"
        android:textColor="@color/bg_color"
        android:background="@drawable/selector_next_button"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/tv_complete_subtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
