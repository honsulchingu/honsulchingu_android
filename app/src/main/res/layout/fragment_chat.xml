<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- 상단 여백을 위한 가이드라인 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.06" /> <!-- 화면 상단의 10%를 여백으로 사용 -->

    <!-- 시작 부분의 가이드라인 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.20" /> <!-- 화면의 20%를 왼쪽 여백으로 사용 -->

    <!-- 배경 커스텀 뷰 -->
    <kr.ac.tukorea.honsulchingu.ui.chat.CurveBackgroundView
        android:id="@+id/curveBackgroundView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- X 버튼 (빨간 원 안에 X) -->
    <ImageButton
        android:id="@+id/btnCloseChat"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_off_button_circle"
        android:src="@drawable/ic_back"
        android:scaleType="center"
        android:contentDescription="닫기"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop"
        app:layout_constraintStart_toStartOf="@id/guidelineStart"/>

    <!-- 채팅 리스트 (리사이클러뷰) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layout_marginTop="10dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnCloseChat"
        app:layout_constraintBottom_toTopOf="@id/layoutChatInput"
        app:layout_constraintStart_toEndOf="@id/guidelineStart"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- 채팅 입력 영역 -->
    <LinearLayout
        android:id="@+id/layoutChatInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_chat_input"
        android:padding="8dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintStart_toEndOf="@id/guidelineStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/editTextMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="메시지를 입력하세요"
            android:textSize="16sp"
            android:fontFamily="@font/pretendard_medium"
            android:background="@android:color/transparent"
            android:padding="12dp"/>

        <ImageButton
            android:id="@+id/buttonSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_send_button"
            android:src="@drawable/ic_send"
            android:contentDescription="보내기"
            android:scaleType="center" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
