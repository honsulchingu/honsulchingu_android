<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color">

    <!-- 상단 배경 + 타이틀 -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_background"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="64dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:text="캐릭터"
            android:textColor="@color/bg_color"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="당신만의 특별한 대화 상대를 찾아보세요"
            android:textColor="@color/bg_color"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 친구/연인 텍스트 탭 (왼쪽 정렬) -->
    <LinearLayout
        android:id="@+id/typeSelectLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <!-- 친구형 탭 -->
        <LinearLayout
            android:id="@+id/friendTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/friendTabText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="친구형"
                android:textColor="@color/purple"
                android:textSize="16sp" />

            <View
                android:id="@+id/friendTabUnderline"
                android:layout_width="100dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@color/purple" />
        </LinearLayout>

        <!-- 연인형 탭 -->
        <LinearLayout
            android:id="@+id/loverTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/loverTabText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="연인형"
                android:textColor="@color/gray"
                android:textSize="16sp" />

            <View
                android:id="@+id/loverTabUnderline"
                android:layout_width="100dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@color/trans" />

        </LinearLayout>

    </LinearLayout>

    <!-- 캐릭터 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/characterRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/characterViewPager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/typeSelectLayout" />

    <!-- 캐릭터 리스트 → ViewPager2로 교체 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/characterViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/typeSelectLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
