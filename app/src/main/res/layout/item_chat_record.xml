<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_color"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_color"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <!-- 프로필 이미지 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/textImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/friend_choiminhyeok"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <!-- 이름 -->
        <TextView
            android:id="@+id/textName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="가나다"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/textTime"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/textImage"
            app:layout_constraintTop_toTopOf="@id/textImage" />

        <!-- 날짜 -->
        <TextView
            android:id="@+id/textTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 00:00"
            android:textColor="#888888"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textName" />

        <!-- 메시지 + 하트 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textName"
            app:layout_constraintTop_toBottomOf="@id/textName">

            <!-- 메시지 텍스트 -->
            <TextView
                android:id="@+id/textMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/chat_bubble_ai"
                android:fontFamily="@font/pretendard_medium"
                android:padding="12dp"
                android:text="가나다라"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnHeart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 하트 아이콘 -->
            <ImageView
                android:id="@+id/btnHeart"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="가나다라"
                android:src="@drawable/ic_heart"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@id/textMessage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textMessage"
                app:layout_constraintTop_toTopOf="@id/textMessage" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 태그 -->
        <LinearLayout
            android:id="@+id/tagContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingBottom="4dp"
            app:layout_constraintStart_toStartOf="@id/messageContainer"
            app:layout_constraintTop_toBottomOf="@id/messageContainer">

            <TextView
                android:id="@+id/textTag1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tag_background"
                android:fontFamily="@font/pretendard_medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="# 가나다라"
                android:textColor="@color/purple"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textTag2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tag_background"
                android:fontFamily="@font/pretendard_medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="# 가나다라"
                android:textColor="@color/purple"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textTag3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tag_background"
                android:fontFamily="@font/pretendard_medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="# 가나다라"
                android:textColor="@color/purple"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 삭제 버튼 -->
        <FrameLayout
            android:id="@+id/delButtonWrapper"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintStart_toStartOf="@id/messageContainer"
            app:layout_constraintTop_toBottomOf="@id/tagContainer">

            <ImageButton
                android:id="@+id/deleteButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_delete" />

        </FrameLayout>

        <!-- 대화 이동 버튼 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/moveButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_purple_rounded"
            android:text="대화로 이동"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tagContainer" />

        <!-- 구분선 -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#E5E7EB"
            app:layout_constraintTop_toBottomOf="@id/moveButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
