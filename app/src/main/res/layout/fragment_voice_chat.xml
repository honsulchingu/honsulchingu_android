<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voiceLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_voicechat"
    android:clipChildren="false"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- 세로 가이드라인 (버튼 위치 조절용) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- 배경 흐림도 -->
    <View
        android:id="@+id/dimmedView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@drawable/dimmed_gradient"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/imageFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="104dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/profile_border"
        app:layout_constraintBottom_toTopOf="@id/speechWaveContainer"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 캐릭터 이미지 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageCharacter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:scaleType="centerCrop"
            android:src="@drawable/friend_choiminhyeok"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.35"
            app:shapeAppearanceOverlay="@style/CircleImage" />

    </FrameLayout>

    <!-- textSpeech와 voiceWaveLottie를 감싸는 FrameLayout 추가 -->
    <FrameLayout
        android:id="@+id/speechWaveContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageFrame">

        <!-- 대화 텍스트 -->
        <TextView
            android:id="@+id/textSpeech"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:maxLines="3"
            android:overScrollMode="ifContentScrolls"
            android:scaleType="centerInside"
            android:scrollbars="vertical"
            android:text="혼술친구를 먼저 정해주세요"
            android:textAlignment="center"
            android:textColor="@color/bg_color"
            android:textSize="16sp" />

        <!-- 🆕 Lottie 파형 뷰, 텍스트 위에 겹치도록 -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/voiceWaveLottie"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:visibility="invisible"
            app:lottie_autoPlay="false"
            app:lottie_fileName="loading_dot.json"
            app:lottie_loop="true" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/micContainer"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/speechWaveContainer">

        <ImageButton
            android:id="@+id/buttonMic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mic_idle"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic_idle" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/micLottie"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:lottie_autoPlay="false"
            app:lottie_fileName="mic_recording.json"
            app:lottie_loop="true" />

    </FrameLayout>

    <!-- 채팅 버튼 -->
    <ImageButton
        android:id="@+id/buttonChat"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_button_circle"
        android:scaleType="centerInside"
        android:src="@drawable/ic_message"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/speechWaveContainer" />

    <!-- 채팅 프래그먼트 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/chatFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
