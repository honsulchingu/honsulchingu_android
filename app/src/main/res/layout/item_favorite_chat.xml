<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    android:background="@color/bg_color">

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#E5E7EB"
        app:layout_constraintTop_toBottomOf="@id/moveButton" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/bg_color">

        <!-- 프로필 이미지 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageProfile"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/friend1"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 이름 -->
        <TextView
            android:id="@+id/nameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="민혁"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/imageProfile"
            app:layout_constraintStart_toEndOf="@id/imageProfile"
            app:layout_constraintEnd_toStartOf="@id/dateText"
            app:layout_constraintHorizontal_bias="0" />

        <!-- 날짜 -->
        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025.04.30"
            android:textSize="12sp"
            android:textColor="#888888"
            app:layout_constraintTop_toTopOf="@id/nameText"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 메시지 + 하트 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/nameText"
            app:layout_constraintStart_toStartOf="@id/nameText"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 메시지 텍스트 -->
            <TextView
                android:id="@+id/messageText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/chat_bubble_ai"
                android:padding="12dp"
                android:text="마지막 메시지가 여기에 들어갑니다."
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_medium"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnHeart"
                />

            <!-- 하트 아이콘 -->
            <ImageView
                android:id="@+id/btnHeart"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ic_heart"
                android:contentDescription="하트"
                app:layout_constraintStart_toEndOf="@id/messageText"
                app:layout_constraintTop_toTopOf="@id/messageText"
                app:layout_constraintBottom_toBottomOf="@id/messageText"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 즐겨찾기 해제 버튼 (휴지통 아이콘) -->
        <ImageButton
            android:id="@+id/unfavButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="즐겨찾기 해제"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/messageContainer"
            app:layout_constraintEnd_toStartOf="@id/moveButton" />

        <!-- 대화 이동 버튼 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/moveButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="대화로 이동"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="@drawable/button_purple_rounded"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/messageContainer"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 구분선 -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB"
            app:layout_constraintTop_toBottomOf="@id/moveButton"
            android:layout_marginTop="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>
