<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- styles.xml -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedCornerImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30%</item>
    </style>

    <style name="TopRoundCardShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>

    </style>

    <style name="HonsulAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/HonsulDialogTitle</item>
        <item name="textAppearanceBody1">@style/HonsulDialogMessage</item>
        <item name="android:background">@drawable/bg_dialog_rounded</item>
    </style>


    <style name="HonsulDialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
    </style>

    <style name="HonsulDialogMessage" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/pretendard_medium</item>
    </style>


    <style name="Widget.Theme.Honsulchingu.MyView" parent="">
        <item name="android:background">#F3F4F6</item>
        <item name="exampleColor">@color/light_blue_400</item>
    </style>

</resources>
